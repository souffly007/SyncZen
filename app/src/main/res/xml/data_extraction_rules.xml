<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde automatique Android 12+ : même exclusion que backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="synczen.db" />
        <exclude domain="database" path="synczen.db-wal" />
        <exclude domain="database" path="synczen.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="synczen.db" />
        <exclude domain="database" path="synczen.db-wal" />
        <exclude domain="database" path="synczen.db-shm" />
    </device-transfer>
</data-extraction-rules>
