<!-- Sauvegarde automatique Android < 12 : on exclut la base Room qui contient
     les identifiants du NAS (nom d'utilisateur / mot de passe). -->
<full-backup-content>
    <exclude domain="database" path="synczen.db" />
    <exclude domain="database" path="synczen.db-wal" />
    <exclude domain="database" path="synczen.db-shm" />
</full-backup-content>
