<?xml version="1.0" encoding="utf-8"?>
<!-- WebDAV requires HTTPS. Trust and hostname verification remain standard.
     SMB uses JCIFS sockets; this HTTP policy does not change its implementation. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
